@baseUrl = http://localhost:4000

### Health check
GET {{baseUrl}}/

### OpenAPI specification
GET {{baseUrl}}/api-docs.json

### Create a user account
POST {{baseUrl}}/user/accounts
Content-Type: application/json

{
  "username": "sample-user",
  "email": "sample@example.com",
  "password": "change-this-password",
  "confirmPassword": "change-this-password"
}

### Log in
POST {{baseUrl}}/user/sessions
Content-Type: application/json

{
  "username": "sample-user",
  "password": "change-this-password"
}

### Sign out
DELETE {{baseUrl}}/user/sessions

### Request a password reset
POST {{baseUrl}}/user/password-resets
Content-Type: application/json

{
  "username": "sample-user",
  "email": "sample@example.com"
}

### Get a preview of the next customer ID
GET {{baseUrl}}/customer/id

### Create a customer
POST {{baseUrl}}/customer
Content-Type: application/json

{
  "name": "Sample Customer",
  "phone": "5550101000",
  "phone2": "",
  "address": "123 Sample Street"
}

### Get all customers
GET {{baseUrl}}/customer

### Get the customer name list
GET {{baseUrl}}/customer/names

### Get a customer by ID
GET {{baseUrl}}/customer/1001

### Get customer details by ID
GET {{baseUrl}}/customer/1001/details

### Update a customer
PUT {{baseUrl}}/customer/1001
Content-Type: application/json

{
  "name": "Updated Sample Customer",
  "phone": "5550101001",
  "phone2": "",
  "address": "456 Example Avenue"
}

### Delete a customer
DELETE {{baseUrl}}/customer/1001

